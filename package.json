    "@next/third-parties": "^15.5.25",
    "@radix-ui/react-slot": "^1.3.3",
    "aws-amplify": "^6.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
