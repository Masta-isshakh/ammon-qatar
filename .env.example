# ---- Public site configuration (safe to expose; read at build time) ----
NEXT_PUBLIC_SITE_URL=https://ammonqatar.com
NEXT_PUBLIC_GTM_ID=

# TODO(owner): verified company details — placeholders render until set
NEXT_PUBLIC_LEGAL_NAME_EN=AMMON QATAR FOR COLLECTION SERVICES W.L.L.
NEXT_PUBLIC_LEGAL_NAME_AR=عمون قطر لخدمات التحصيل ذ.م.م.
NEXT_PUBLIC_CR_NUMBER=
NEXT_PUBLIC_PHONE_E164=+97400000000
NEXT_PUBLIC_WHATSAPP_NUMBER=97400000000
NEXT_PUBLIC_EMAIL=info@ammonqatar.com
NEXT_PUBLIC_ADDRESS_STREET=Doha, Qatar
NEXT_PUBLIC_PO_BOX=
NEXT_PUBLIC_GEO_LAT=25.2854
NEXT_PUBLIC_GEO_LNG=51.5310
NEXT_PUBLIC_HOURS_OPEN=08:00
NEXT_PUBLIC_HOURS_CLOSE=17:00
NEXT_PUBLIC_FOUNDING_YEAR=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
# Comma-separated keys of verified credentials to show as trust badges: cr,moci,insured
NEXT_PUBLIC_VERIFIED_CREDENTIALS=
# Set to "false" to hide the footer legal disclaimer after legal review
NEXT_PUBLIC_SHOW_LEGAL_DISCLAIMER=true

# ---- Backend (Amplify function env, never exposed to the browser) ----
# Both addresses must be verified in Amazon SES for the app region.
NOTIFY_FROM_EMAIL=leads@ammonqatar.com
NOTIFY_TO_EMAIL=operations@ammonqatar.com
