{
  "name": "ammon-qatar",
  "version": "1.0.0",
  "private": true,
  "description": "Ammon Qatar — bilingual (EN/AR) debt collection & receivables recovery website. Next.js 15 + AWS Amplify Gen 2.",
  "scripts": {
    "predev": "node scripts/prepare-dev.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/ensure-amplify-outputs.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sandbox": "ampx sandbox",
    "clean": "node scripts/prepare-dev.mjs",
    "assets:favicon": "node scripts/generate-favicon.mjs",
    "assets:placeholders": "node scripts/generate-placeholders.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1137.0",
